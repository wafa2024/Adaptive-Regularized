{
  "dataset": "cicids2017",
  "data_paths": [
    "/content/ARTGL_work/data/CICIDS2017/TrafficLabelling/*.csv"
  ],
  "feature_set": "full",
  "label_mode": "binary",
  "label_col": null,
  "time_col": null,
  "src_col": null,
  "dst_col": null,
  "protocol_col": null,
  "drop_cols": [],
  "discrete_cols": [],
  "benign_values": [
    "benign",
    "normal",
    "0"
  ],
  "split": "chronological",
  "train_frac": 0.7,
  "val_frac": 0.1,
  "split_seed": 42,
  "temporal_window": 60.0,
  "max_neighbors": 30,
  "similarity_threshold": 0.65,
  "alpha": 0.5,
  "beta": 0.1,
  "temporal_key": "pair",
  "hidden_dim": 64,
  "num_layers": 2,
  "dropout": 0.3,
  "adaptive_edges": true,
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "max_epochs": 200,
  "patience": 20,
  "batch_size": 1024,
  "lambda_temp": 0.01,
  "lambda_graph": 0.01,
  "lambda_sparse": 0.001,
  "lambda_robust": 0.01,
  "train_epsilon": 0.05,
  "sparsity_threshold": 0.001,
  "noise_epsilons": [
    0.01,
    0.05,
    0.1,
    0.2
  ],
  "noise_draws": 5,
  "ablation_epsilon": 0.1,
  "adv_epsilon": 0.05,
  "pgd_steps": 10,
  "pgd_step_size": 0.01,
  "eval_chunk_size": 8192,
  "seeds": [
    0,
    1,
    2,
    3,
    4
  ],
  "output_dir": "/content/drive/MyDrive/datasets/ARTGL_results",
  "device": "auto"
}